---
import { render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryArticle from '../../components/portfolio/EntryArticle.astro';
import { getPortfolioEntries, toEntrySlug } from '../../lib/portfolio';

export async function getStaticPaths() {
  const entries = await getPortfolioEntries();

  return entries
    .filter((entry) => entry.data.section === 'other')
    .map((entry) => ({
      params: { slug: toEntrySlug(entry) },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout pageTitle={entry.data.title + ' | Kevin Lan'}>
  <EntryArticle entry={entry}>
    <Content />
  </EntryArticle>
</BaseLayout>
