---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/portfolio/SiteHeader.astro';
import SiteFooter from '../components/portfolio/SiteFooter.astro';
import EntryGrid from '../components/portfolio/EntryGrid.astro';
import { HomeHero } from '../components/portfolio/HomeHero';
import { getEntriesBySection, sectionLabels } from '../lib/portfolio';

const entriesBySection = await getEntriesBySection();
---

<BaseLayout pageTitle="Kevin Lan | Portfolio">
  <SiteHeader />

  <div class="home-hero">
    <HomeHero client:load colorMode="dark" />
  </div>

  <EntryGrid label={sectionLabels.experience} entries={entriesBySection.experience} />
  <EntryGrid label={sectionLabels.projects} entries={entriesBySection.projects} />
  <SiteFooter />
</BaseLayout>
