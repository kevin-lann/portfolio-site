---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';
import Keybinds from '../components/portfolio/Keybinds.astro';

import { getPortfolioEntries, toEntryHref } from '../lib/portfolio';

interface Props {
  pageTitle: string;
  description?: string;
}

const { pageTitle, description = 'Software engineer based in Toronto delivering backend-heavy applications. University of Toronto 4th year CS student.' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const agentIndexUrl = new URL('/llms.txt', Astro.site);

// A hidden, ordered list of every entry so arrow-key navigation works on
// every page (home + article pages) without any visible sidebar.
const orderedEntries = await getPortfolioEntries();
---

<html lang="en">
  <Analytics />
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="text/markdown" href={agentIndexUrl.href} title="Agent-readable index" />
    <ClientRouter />
    <script is:inline>
      try {
        if (window.localStorage.getItem('portfolio-reading-mode') === 'agent') {
          document.documentElement.setAttribute('data-reading-mode', 'agent');
        }
      } catch {
        // Storage can be unavailable. Human mode stays the default.
      }
    </script>
  </head>
  <body>
    <main class="portfolio-root" data-color-mode="dark">
      <div class="page-shell">
        <slot />
      </div>

      <nav class="sr-only" aria-hidden="true" data-entry-nav>
        <a href="/" data-nav-target="home">home</a>
        {orderedEntries.map((entry) => (
          <a href={toEntryHref(entry)} data-entry-section={entry.data.section}>
            {entry.data.title}
          </a>
        ))}
      </nav>

      <Keybinds />
      <div class="circle" aria-hidden="true"></div>
    </main>

    <script is:inline data-astro-rerun>
      (() => {
        window.__portfolioPageCleanup?.();

        const COLOR_MODE_STORAGE_KEY = 'portfolio-color-mode';
        const AMBIENCE_STORAGE_KEY = 'portfolio-ambience-enabled';
        const READING_MODE_STORAGE_KEY = 'portfolio-reading-mode';

        const pageController = new AbortController();
        window.__portfolioPageCleanup = () => pageController.abort();

        const withSignal = (options = {}) => ({
          ...options,
          signal: pageController.signal
        });

        const root = document.documentElement;
        const circleElement = document.querySelector('.circle');
        const contentMarkdown = document.querySelector('[data-content-markdown]');
        const contentToc = document.querySelector('[data-content-toc]');
        const contentTocList = document.querySelector('[data-content-toc-list]');

        const validColorModes = new Set(['dark', 'light', 'summer', 'night']);
        const storedMode = window.localStorage.getItem(COLOR_MODE_STORAGE_KEY) || 'dark';
        let colorMode = validColorModes.has(storedMode) ? storedMode : 'dark';

        const readReadingMode = () => {
          try {
            return window.localStorage.getItem(READING_MODE_STORAGE_KEY) === 'agent' ? 'agent' : 'human';
          } catch {
            return 'human';
          }
        };

        const applyReadingMode = (mode) => {
          const nextMode = mode === 'agent' ? 'agent' : 'human';
          root.setAttribute('data-reading-mode', nextMode);
          try {
            window.localStorage.setItem(READING_MODE_STORAGE_KEY, nextMode);
          } catch {
            // Storage can be unavailable. The current page still switches.
          }

          document.querySelectorAll('[data-reading-tab]').forEach((tab) => {
            const selected = tab.getAttribute('data-reading-tab') === nextMode;
            tab.setAttribute('aria-selected', selected ? 'true' : 'false');
            tab.tabIndex = selected ? 0 : -1;
          });

          const humanView = document.getElementById('human-view');
          const agentView = document.getElementById('agent-view');
          if (humanView) humanView.hidden = nextMode === 'agent';
          if (agentView) agentView.hidden = nextMode !== 'agent';
        };

        document.addEventListener('astro:before-swap', (event) => {
          const nextMode = window.localStorage.getItem(COLOR_MODE_STORAGE_KEY) || colorMode;
          if (validColorModes.has(nextMode)) {
            event.newDocument.documentElement.setAttribute('data-color-mode', nextMode);
          }
          if (readReadingMode() === 'agent') {
            event.newDocument.documentElement.setAttribute('data-reading-mode', 'agent');
          }
        }, withSignal());

        applyReadingMode(readReadingMode());

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const tab = target.closest('[data-reading-tab]');
          if (tab instanceof HTMLElement) {
            applyReadingMode(tab.getAttribute('data-reading-tab'));
            return;
          }

          const copyButton = target.closest('[data-copy-agent-markdown]');
          if (!(copyButton instanceof HTMLButtonElement)) return;
          const code = document.querySelector('#agent-view code');
          const text = code?.textContent ?? '';
          if (!text) return;

          void navigator.clipboard.writeText(text).then(() => {
            const previous = copyButton.textContent;
            copyButton.textContent = 'Copied';
            window.setTimeout(() => {
              if (copyButton.isConnected) copyButton.textContent = previous;
            }, 1400);
          }).catch(() => undefined);
        }, withSignal());

        window.__portfolioAmbience ??= {
          summer: new Audio('/sounds/breach-ambience.mp3'),
          night: new Audio('/sounds/night-ambience.mp3')
        };

        const ambience = window.__portfolioAmbience;
        ambience.summer.loop = true;
        ambience.summer.preload = 'auto';
        ambience.summer.volume = 0.25;
        ambience.night.loop = true;
        ambience.night.preload = 'auto';
        ambience.night.volume = 0.35;

        const stopAmbience = (audio) => {
          audio.pause();
          audio.currentTime = 0;
        };

        const setColorMode = (mode, options = {}) => {
          if (!validColorModes.has(mode)) return;
          colorMode = mode;
          root.setAttribute('data-color-mode', colorMode);
          window.localStorage.setItem(COLOR_MODE_STORAGE_KEY, colorMode);
          if ((colorMode === 'summer' || colorMode === 'night') && options.playAmbience) {
            window.sessionStorage.setItem(AMBIENCE_STORAGE_KEY, 'true');
          } else if (colorMode !== 'summer' && colorMode !== 'night') {
            window.sessionStorage.removeItem(AMBIENCE_STORAGE_KEY);
          }

          window.dispatchEvent(
            new CustomEvent('portfolio-color-mode-change', {
              detail: { colorMode }
            })
          );

          if (colorMode === 'summer') {
            if (options.playAmbience) {
              void ambience.summer.play().catch(() => undefined);
            }
          } else {
            stopAmbience(ambience.summer);
          }

          if (colorMode === 'night') {
            if (options.playAmbience) {
              void ambience.night.play().catch(() => undefined);
            }
          } else {
            stopAmbience(ambience.night);
          }
        };

        setColorMode(colorMode, {
          playAmbience: window.sessionStorage.getItem(AMBIENCE_STORAGE_KEY) === 'true'
        });

        // Image lightbox
        let lightbox = null;
        const closeLightbox = () => {
          if (!lightbox) return;
          lightbox.remove();
          lightbox = null;
          document.body.style.overflow = '';
        };

        if (contentMarkdown) {
          contentMarkdown.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLImageElement)) return;

            event.preventDefault();
            const overlay = document.createElement('div');
            overlay.className = 'image-lightbox';
            overlay.setAttribute('role', 'dialog');
            overlay.setAttribute('aria-modal', 'true');
            overlay.setAttribute('aria-label', target.alt || 'Expanded image');

            const image = document.createElement('img');
            image.className = 'image-lightbox-image';
            image.src = target.src;
            image.alt = target.alt || '';
            image.addEventListener('click', (innerEvent) => innerEvent.stopPropagation(), withSignal());

            overlay.appendChild(image);
            overlay.addEventListener('click', closeLightbox, withSignal());
            document.body.appendChild(overlay);
            document.body.style.overflow = 'hidden';
            lightbox = overlay;
          }, withSignal());
        }

        // On-this-page table of contents (only when there is enough content)
        const slugify = (text) =>
          text
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '');

        if (
          contentToc instanceof HTMLElement &&
          contentTocList instanceof HTMLElement &&
          contentMarkdown instanceof HTMLElement
        ) {
          const headingElements = Array.from(contentMarkdown.querySelectorAll('h1, h2, h3'))
            .filter((element) => element.textContent && element.textContent.trim().length > 0);

          if (headingElements.length > 1) {
            const usedIds = new Set();
            const tocLinks = [];

            headingElements.forEach((heading, index) => {
              let headingId = heading.id ? heading.id.trim() : '';
              if (!headingId) {
                headingId = slugify(heading.textContent || '') || 'section';
              }

              let uniqueId = headingId;
              let suffix = 2;
              while (usedIds.has(uniqueId)) {
                uniqueId = headingId + '-' + suffix;
                suffix += 1;
              }

              usedIds.add(uniqueId);
              heading.id = uniqueId;

              const item = document.createElement('li');
              const link = document.createElement('a');
              link.href = '#' + uniqueId;
              link.textContent = heading.textContent || '';
              link.dataset.targetId = uniqueId;
              link.className = 'content-toc-link';
              if (index === 0) link.classList.add('is-active');
              const level = Number(heading.tagName.slice(1));
              const indentation = Math.max(0, level - 1) * 0.58 + 0.32;
              link.style.paddingLeft = indentation + 'rem';
              item.appendChild(link);
              contentTocList.appendChild(item);
              tocLinks.push(link);
            });

            const setActiveLink = (activeId) => {
              tocLinks.forEach((link) => {
                link.classList.toggle('is-active', link.dataset.targetId === activeId);
              });
            };

            const updateActiveHeading = () => {
              let activeId = headingElements[0].id;
              headingElements.forEach((heading) => {
                if (heading.getBoundingClientRect().top <= 140) {
                  activeId = heading.id;
                }
              });
              setActiveLink(activeId);
            };

            window.addEventListener('scroll', updateActiveHeading, withSignal({ passive: true }));
            updateActiveHeading();

            contentToc.addEventListener('click', (event) => {
              const target = event.target;
              if (!(target instanceof HTMLAnchorElement)) return;
              const targetId = target.dataset.targetId;
              if (!targetId) return;
              const heading = document.getElementById(targetId);
              if (!heading) return;
              event.preventDefault();
              heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
              history.replaceState(null, '', '#' + targetId);
              setActiveLink(targetId);
            }, withSignal());

            contentToc.hidden = false;
          }
        }

        // Arrow-key navigation between entries (home + article pages)
        const handleArrowNavigation = (key) => {
          const selectableEntries = Array.from(
            document.querySelectorAll(
              'a[data-nav-target="home"], a[data-entry-section="experience"], a[data-entry-section="projects"], a[data-entry-section="other"]'
            )
          );

          if (!selectableEntries.length) return;

          const currentPath = window.location.pathname.replace(/\/$/, '');
          const currentIndex = selectableEntries.findIndex((entry) => {
            const entryPath = new URL(entry.href).pathname.replace(/\/$/, '');
            return entryPath === currentPath;
          });

          const fallbackIndex = key === 'arrowdown' ? 0 : selectableEntries.length - 1;
          const startIndex = currentIndex === -1 ? fallbackIndex : currentIndex;
          const step = key === 'arrowdown' ? 1 : -1;
          const nextIndex = (startIndex + step + selectableEntries.length) % selectableEntries.length;
          const nextEntry = selectableEntries[nextIndex];

          if (nextEntry) nextEntry.click();
        };

        window.addEventListener('keydown', (event) => {
          if (lightbox && event.key === 'Escape') {
            closeLightbox();
            return;
          }

          const target = event.target;
          const isTyping =
            target instanceof HTMLElement &&
            (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
          if (isTyping) return;

          const key = event.key.toLowerCase();

          if (key === 'f') {
            if (document.fullscreenElement) {
              void document.exitFullscreen().catch(() => undefined);
            } else {
              void document.documentElement.requestFullscreen().catch(() => undefined);
            }
            return;
          }

          if (key === 'l') return setColorMode('light');
          if (key === 'd') return setColorMode('dark');
          if (key === 's') return setColorMode('summer', { playAmbience: true });
          if (key === 'n') return setColorMode('night', { playAmbience: true });

          if (
            (key === 'arrowleft' || key === 'arrowright') &&
            target instanceof HTMLElement &&
            target.hasAttribute('data-reading-tab')
          ) {
            event.preventDefault();
            const nextReadingMode = key === 'arrowright' ? 'agent' : 'human';
            applyReadingMode(nextReadingMode);
            const nextTab = document.querySelector('[data-reading-tab="' + nextReadingMode + '"]');
            if (nextTab instanceof HTMLElement) nextTab.focus();
            return;
          }

          if (key === 'arrowdown' || key === 'arrowup') {
            event.preventDefault();
            handleArrowNavigation(key);
          }
        }, withSignal());

        // Trailing cursor circle
        if (circleElement instanceof HTMLDivElement) {
          const mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
          const previousMouse = { x: mouse.x, y: mouse.y };
          const circle = { x: mouse.x, y: mouse.y };

          let currentScale = 0;
          let currentAngle = 0;
          let frameId = 0;
          let hasMoved = false;
          const speed = 0.17;

          const handleMouseMove = (event) => {
            mouse.x = event.clientX;
            mouse.y = event.clientY;
            if (!hasMoved) {
              hasMoved = true;
              circleElement.classList.add('is-visible');
            }
          };

          const tick = () => {
            circle.x += (mouse.x - circle.x) * speed;
            circle.y += (mouse.y - circle.y) * speed;
            const translateTransform = 'translate(' + circle.x + 'px, ' + circle.y + 'px)';

            const deltaMouseX = mouse.x - previousMouse.x;
            const deltaMouseY = mouse.y - previousMouse.y;
            previousMouse.x = mouse.x;
            previousMouse.y = mouse.y;

            const mouseVelocity = Math.min(Math.sqrt(deltaMouseX ** 2 + deltaMouseY ** 2) * 4, 150);
            const scaleValue = (mouseVelocity / 150) * 0.5;
            currentScale += (scaleValue - currentScale) * speed;
            const scaleTransform = 'scale(' + (1 + currentScale) + ', ' + (1 - currentScale) + ')';

            const angle = (Math.atan2(deltaMouseY, deltaMouseX) * 180) / Math.PI;
            if (mouseVelocity > 20) {
              currentAngle = angle;
            }
            const rotateTransform = 'rotate(' + currentAngle + 'deg)';

            circleElement.style.transform =
              translateTransform + ' ' + rotateTransform + ' ' + scaleTransform;

            frameId = window.requestAnimationFrame(tick);
          };

          window.addEventListener('mousemove', handleMouseMove, withSignal());
          frameId = window.requestAnimationFrame(tick);

          const stopCursorAnimation = () => {
            window.cancelAnimationFrame(frameId);
            window.removeEventListener('mousemove', handleMouseMove);
          };

          pageController.signal.addEventListener('abort', stopCursorAnimation, { once: true });
          window.addEventListener('beforeunload', stopCursorAnimation, withSignal({ once: true }));
        }
      })();
    </script>
  </body>
</html>
